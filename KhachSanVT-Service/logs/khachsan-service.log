WHERE gpt.ngay_bat_dau <= CURRENT_DATE
  AND gpt.ngay_ket_thuc >= CURRENT_DATE
  AND gpt.trang_thai = true
ORDER BY lg.ma_loai_gia, gp.ma_gia_phong;

