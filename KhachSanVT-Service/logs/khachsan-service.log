        gp.gia_giuong AS giaGiuong,
        gp.maloaiphong AS maLoaiPhong 
    FROM
        loai_gia lg 
    LEFT JOIN
        gia_phong gp 
            ON lg.ma_loai_gia = gp.ma_gia_phong 
    JOIN
        gia_phong_thoi_gian gpt 
            ON gp.ma_gia_phong = gpt.ma_gia 
    WHERE
        gpt.ngay_bat_dau <= CURRENT_DATE   
        AND gpt.ngay_ket_thuc >= CURRENT_DATE   
        AND gpt.trang_thai = true 
    ORDER BY
        lg.ma_loai_gia,
        gp.ma_gia_phong; 
