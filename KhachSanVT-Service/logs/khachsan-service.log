    lg.ma_loai_gia AS maLoaiGia,
    lg.ten_loai_gia AS tenLoaiGia,
    gp.ma_gia_phong AS maGiaPhong,
    gp.gia AS gia,
    gp.gia_cuoi_tuan AS giaCuoiTuan,
