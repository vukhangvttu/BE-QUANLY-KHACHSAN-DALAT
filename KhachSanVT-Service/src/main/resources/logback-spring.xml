<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender cho development với màu sắc -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight([%-5level]) %cyan([%thread]) %yellow(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File Appender cho tất cả log (không màu) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/khachsan-service.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/khachsan-service.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- File Appender riêng cho Scheduled Task -->
    <appender name="SCHEDULED_TASK_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/scheduled-task/room-status-update.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] [%thread] %logger{50} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Rotation theo ngày -->
            <fileNamePattern>logs/scheduled-task/room-status-update.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Giữ lại log 90 ngày -->
            <maxHistory>90</maxHistory>
            <!-- Tổng dung lượng tối đa -->
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <!-- Giới hạn kích thước mỗi file -->
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
    </appender>

    <!-- Console Appender riêng cho Scheduled Task với màu sắc -->
    <appender name="SCHEDULED_TASK_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight([%-5level]) %magenta([SCHEDULED]) %cyan([%thread]) %yellow(%logger{50}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logger riêng cho ScheduledTaskService -->
    <logger name="vttu.khachsanservice.service.ScheduledTaskService" level="DEBUG" additivity="false">
        <appender-ref ref="SCHEDULED_TASK_FILE"/>
        <appender-ref ref="SCHEDULED_TASK_CONSOLE"/>
    </logger>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Logger cho Spring Framework (optional) -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.hibernate" level="INFO"/>
</configuration>
