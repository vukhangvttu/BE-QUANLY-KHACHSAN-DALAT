              "key": "startDate",
              "value": "2025-12-26"
            },
            {
              "key": "endDate",
              "value": "2025-12-28"
            },
            {
              "key": "quantity",
              "value": "10",
              "description": "Số lượng phòng yêu cầu (mặc định = 1)"
            }
          ]
        },
        "description": "Kiểm tra xem có đủ 10 phòng CS-C-D từ 26/12 đến 28/12 không"
