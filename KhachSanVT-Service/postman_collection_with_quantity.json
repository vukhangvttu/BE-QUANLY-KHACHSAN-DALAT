{
  "info": {
    "name": "Room Availability API với Quantity",
    "description": "API kiểm tra phòng trống - Hỗ trợ số lượng phòng yêu cầu",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Check Room Availability với Quantity (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingDetails\": [\n    {\n      \"roomTypeId\": \"CS-C-D\",\n      \"quantity\": 10,\n      \"listDate\": [\n        { \"ngay\": \"2025-12-26\" },\n        { \"ngay\": \"2025-12-27\" },\n        { \"ngay\": \"2025-12-28\" }\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "http://localhost:8310/khachsan-service/api/room-availability/check",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8310",
          "path": ["khachsan-service", "api", "room-availability", "check"]
        },
        "description": "Kiểm tra phòng trống với số lượng cụ thể.\n\nYêu cầu 10 phòng loại CS-C-D cho 3 ngày."
      },
      "response": []
    },
    {
      "name": "2. Check Range với Quantity (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8310/khachsan-service/api/room-availability/check-range?roomTypeId=CS-C-D&startDate=2025-12-26&endDate=2025-12-28&quantity=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8310",
          "path": ["khachsan-service", "api", "room-availability", "check-range"],
